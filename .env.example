# Database (local Docker Compose defaults)
DATABASE_URL="postgresql://rackpatch:rackpatch@localhost:5432/rackpatch?schema=public"

# App URL used for magic links and QR codes
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Development-only passwordless email login. MUST be false/unset in production.
# App refuses to start in production if this is true.
ENABLE_DEV_LOGIN="true"

# Optional: Resend for production magic-link email
# RESEND_API_KEY=""
# EMAIL_FROM="RackPatch <noreply@yourdomain.com>"

# Comma-separated emails with platform-admin powers (activate paid pilots on hosted SaaS).
# The first-run bootstrap admin also receives platformAdmin=true in the database.
PLATFORM_ADMIN_EMAILS="admin@example.com"

# Hosted SaaS only: when "true", project mutations require PILOT/PAID (or demo).
# Leave unset/false for Community Edition / self-host (recommended default).
# HOSTED_SAAS="false"

# Continuous compliance cron: POST /api/internal/compliance-check with header
# x-compliance-secret: <this value>. Route returns 503 when unset. Use a long random value.
# COMPLIANCE_CRON_SECRET=""

# Optional: let an LLM reword assistant answers. Grounded in project facts only; falls back to
# rule-based answers if unset, failing, or if output contains numbers not in the project data.
# Cable IDs / device names / counts are sent to OpenAI when set.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Integrations (NetBox dry-run, outbound webhooks): https only. Loopback, link-local and cloud
# metadata addresses are always blocked. Set true ONLY on self-host to allow RFC1918/CGNAT targets
# (e.g. an on-prem NetBox). Default: private ranges blocked.
# INTEGRATION_ALLOW_PRIVATE_NETWORKS="false"

# Optional: notify this address when a pilot request is submitted
# PILOT_NOTIFY_EMAIL=""

# Opt-in demo seed only. Never overwrite real customer workspaces.
# SEED_DEMO="true"

# Railway sets PORT automatically. Local default is 3000.
# PORT=3000
NODE_ENV="development"
